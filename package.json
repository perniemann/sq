{
  "name": "sq",
  "private": true,
  "license": "MIT",
  "version": "0.1.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/prerender-design-html.mjs",
    "design-ref:coverage": "node scripts/design-reference-coverage.mjs",
    "design-ref:plates": "node scripts/gen-design-media-plates.mjs",
    "design-ref:capture": "node scripts/capture-design-media.mjs",
    "gen:favicon": "node scripts/gen-favicon-png.mjs",
    "lint": "eslint .",
    "measure:glb": "node scripts/measure-glb.mjs",
    "preview": "vite preview",
    "test": "vitest run && node scripts/design-reference-coverage.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "release:dry-run": "npx --yes release-please release-pr --dry-run --token=unused --repo-url=perniemann/sq"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/perniemann/sq.git"
  },
  "bugs": {
    "url": "https://github.com/perniemann/sq/issues"
  },
  "homepage": "https://github.com/perniemann/sq#readme",
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@react-three/postprocessing": "^3.0.4",
    "@react-three/rapier": "^2.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.182.0",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "playwright": "^1.62.1",
    "sharp": "^0.34.5",
    "typescript": "~5.7.0",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.10"
  }
}
